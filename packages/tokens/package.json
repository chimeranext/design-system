{
  "name": "@chimeranext/tokens",
  "version": "0.1.0",
  "description": "Canonical ChimeraNext design tokens — Style Dictionary pipeline producing themed CSS variables, a Tailwind preset, a JS token export, and Dart constants.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "build/tokens.js",
  "exports": {
    ".": "./build/tokens.js",
    "./css": "./build/css/variables.css",
    "./preset": "./build/tailwind-preset.js",
    "./dart": "./build/dart/chimera_tokens.dart"
  },
  "files": [
    "build",
    "tokens.json",
    "build.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf build",
    "design:lint": "npx \"@google/design.md\" lint ../../DESIGN.md"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "style-dictionary": "^4.3.0",
    "style-dictionary-utils": "^4.2.1"
  }
}
